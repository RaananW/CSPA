    "colour": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Key light colour (Objects level).",
      "$extensions": {
        "dev.underglass.strata": {
          "scope": false
        }
      }
    }
  },
  "camera": {
    "distance": {
      "$type": "dimension",
      "$value": "1600px",
      "$description": "Minimum camera distance; validation raises it to satisfy the taper rule.",
      "$extensions": {
        "dev.underglass.strata": {
          "min": 400,
          "scope": false
