    "ambient": {
      "$type": "number",
      "$value": 0.55,
      "$description": "Fill light strength (Objects level).",
      "$extensions": {
        "dev.underglass.strata": {
          "min": 0.2,
          "max": 1,
          "scope": false
        }
      }
