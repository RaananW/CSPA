    "$type": "number",
    "$value": 0.5,
    "$description": "Depth setting: 0 = subtle, 0.5 = medium (default), 1 = bold.",
    "$extensions": {
      "dev.underglass.strata": {
        "min": 0,
        "max": 1,
        "scope": true
      }
    }
  },
  "light": {
    "azimuth": {
      "$type": "number",
      "$value": 323,
      "$description": "Where the light comes from, degrees clockwise from the top of the screen.",
      "$extensions": {
        "dev.underglass.strata": {
          "min": 0,
          "max": 359,
          "scope": false
        }
      }
    },
    "elevation": {
      "$type": "number",
      "$value": 41,
      "$description": "Light height above the panel plane, degrees.",
      "$extensions": {
        "dev.underglass.strata": {
          "min": 20,
          "max": 80,
          "scope": false
        }
      }
    },
    "intensity": {
      "$type": "number",
      "$value": 1.6,
      "$description": "Key light strength (Objects level).",
      "$extensions": {
        "dev.underglass.strata": {
          "min": 0.5,
          "max": 3,
          "scope": false
        }
