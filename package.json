{
  "name": "canvas-spa-phase-one",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/library/index.js",
  "types": "./dist/library/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/library/index.d.ts",
      "import": "./dist/library/index.js"
    }
  },
  "files": [
    "dist/library/*.js",
    "dist/library/*.d.ts",
    "docs/distribution.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:library": "vite build --config vite.library.config.ts && tsc -p tsconfig.library.json",
    "prepack": "npm run build:library",
    "test:package": "node scripts/package-consumer.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:unit && npm run build && npm run test:browser",
    "test:unit": "node --test tests/*.unit.test.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "probe": "node scripts/browser-probe.mjs",
    "test:react18": "node scripts/react-matrix.mjs",
    "test:react19": "node scripts/react-matrix.mjs --primary",
    "measure": "npm run build && node scripts/measure.mjs"
  },
  "dependencies": {
    "@types/webxr": "0.5.24",
    "@babylonjs/lite": "1.33.0"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "1.2.0",
    "@babylonjs/lite-gl": "1.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@playwright/test": "1.64.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
