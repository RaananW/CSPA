{
  "name": "canvas-spa-repository",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": ["packages/canvas-spa", "packages/css-compiler", "examples/playground", "examples/showcase"],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:library && npm run build --workspace @canvas-spa/playground",
    "build:library": "npm run build --workspace @canvas-spa/react",
    "dev:showcase": "npm run build:library && npm run dev --workspace @canvas-spa/showcase",
    "build:showcase": "npm run build:library && npm run build --workspace @canvas-spa/showcase",
    "preview:showcase": "npm run preview --workspace @canvas-spa/showcase",
    "test:showcase": "node scripts/showcase-validation.mjs",
    "pack:library": "npm pack --workspace @canvas-spa/react",
    "prepack": "node -e \"throw new Error('Tooling root is not the release package; use npm run pack:library')\"",
    "test:package": "node scripts/package-consumer.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run test:unit && npm run build && node scripts/test-browser.mjs",
    "test:unit": "node --test tests/unit/*.unit.test.mjs",
    "test:compiler": "npm run build:library && node scripts/compiler-validation.mjs",
    "test:worker": "node scripts/worker-validation.mjs",
    "test:browser": "npm run build && node scripts/test-browser.mjs",
    "typecheck": "tsc -p packages/canvas-spa/tsconfig.json --noEmit && tsc -p examples/playground/tsconfig.json --noEmit && tsc -p examples/showcase/tsconfig.json --noEmit",
    "probe": "node scripts/browser-probe.mjs",
    "test:react18": "node scripts/react-matrix.mjs",
    "test:react19": "node scripts/react-matrix.mjs --primary",
    "measure": "npm run build && node scripts/measure.mjs",
    "validate:release": "node scripts/release-validation.mjs"
  },
  "devDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@playwright/test": "1.64.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "webpack": "5.111.1",
    "sass": "1.105.1",
    "css-loader": "7.1.5",
    "sass-loader": "17.0.1",
    "postcss-loader": "8.2.1"
  }
}
