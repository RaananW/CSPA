---
/**
 * Switch (anatomy page `switch.md`): `<input type="checkbox" role="switch">` in its label row; the slot is the label,
 * which must not contain "on" or "off". `reverse` puts the label first visually and keeps the DOM order.
 */
import Field from "./Field.astro";
import { fieldControl } from "./field.ts";
import { classes, strataAttributes, type StrataLevel, type StrataSize } from "../shared/markup.ts";

interface Props {
  id?: string;
  checked?: boolean;
  reverse?: boolean;
  help?: string;
  error?: string;
  required?: boolean;
  disabled?: boolean;
  invalid?: boolean;
  errorPrefix?: string;
  size?: StrataSize;
  material?: string;
  level?: StrataLevel;
  class?: string;
  style?: string;
  [attribute: string]: unknown;
}

const { id, checked, reverse = false, help, error, required, disabled, invalid, errorPrefix, size, material, level, class: className, style, ...rest } = Astro.props;
const field = fieldControl({ id, help, error, required, disabled, invalid }, "switch");
---
<Field wrap={field.wrap} controlId={field.id} help={help} error={error} errorPrefix={errorPrefix}>
  <label class={classes("ug-switch", reverse && "ug-switch--reverse", className)} style={style} {...strataAttributes({ size, material, level })}><input class="ug-switch__input" data-strata-face="well" type="checkbox" role="switch" checked={checked} {...field.attrs} {...rest} /><span class="ug-switch__knob" data-strata-face="knob" aria-hidden="true"></span><span class="ug-switch__label"><slot /></span></label>
</Field>
