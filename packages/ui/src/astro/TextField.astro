---
/**
 * TextField (anatomy page `text-field.md`): a native `<input>` well. With Field props it renders its Field; with an
 * `icon` slot the input sits in a wrapper that carries the well and the focus edge.
 */
import Field from "./Field.astro";
import { fieldControl } from "./field.ts";
import { classes, strataAttributes, type StrataLevel, type StrataSize } from "../shared/markup.ts";

interface Props {
  id?: string;
  label?: string;
  help?: string;
  error?: string;
  required?: boolean;
  disabled?: boolean;
  invalid?: boolean;
  requiredLabel?: string;
  errorPrefix?: string;
  size?: StrataSize;
  material?: string;
  level?: StrataLevel;
  class?: string;
  [attribute: string]: unknown;
}

const { id, label, help, error, required, disabled, invalid, requiredLabel, errorPrefix, size, material, level, class: className, ...rest } = Astro.props;
const field = fieldControl({ id, label, help, error, required, disabled, invalid });
const strata = strataAttributes({ size, material, level });
---
<Field wrap={field.wrap} controlId={field.id} label={label} help={help} error={error} required={required} requiredLabel={requiredLabel} errorPrefix={errorPrefix}>
  {Astro.slots.has("icon")
    ? <span class="ug-text-field__wrap" data-strata-face="well" {...strata}><span class="ug-text-field__icon" aria-hidden="true"><slot name="icon" /></span><input class={classes("ug-text-field__input", className)} {...field.attrs} {...rest} /></span>
    : <input class={classes("ug-text-field", className)} data-strata-face="well" {...strata} {...field.attrs} {...rest} />}
</Field>
