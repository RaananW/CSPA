---
/** ProgressBar (anatomy page `progress-bar.md`): a native `<progress>`; indeterminate without `value`. */
import Field from "./Field.astro";
import { fieldControl } from "./field.ts";
import { classes } from "../shared/markup.ts";

interface Props {
  id?: string;
  value?: number;
  max?: number;
  label?: string;
  help?: string;
  class?: string;
  [attribute: string]: unknown;
}

const { id, value, max = 100, label, help, class: className, ...rest } = Astro.props;
const field = fieldControl({ id, label, help }, "progress");
// A progress bar takes the Field's id and description only; it has no required, disabled or invalid state.
const { id: controlId, "aria-describedby": describedBy } = field.attrs;
---
<Field wrap={field.wrap} controlId={field.id} label={label} help={help}>
  <progress class={classes("ug-progress", className)} data-strata-face="groove" id={controlId} aria-describedby={describedBy} value={value} max={max} {...rest}></progress>
</Field>
