---
/**
 * Rating (anatomy page `rating.md`): native radios in a `<fieldset>` named by its `<legend>`, one per score, each
 * visually hidden over its star. `value` is the checked score; arrow keys, Tab and Space stay native, so it needs no
 * script.
 */
import { ratingItemLabel } from "../shared/rating.ts";
import { classes, strataAttributes, type StrataLevel, type StrataSize } from "../shared/markup.ts";

interface Props {
  /** Names the group, as the `<legend>`. */
  label: string;
  name: string;
  /** The highest score; 5 by default. */
  max?: number;
  /** The checked score. */
  value?: number;
  /** Each star's name; "1 star", "2 stars" by default. */
  itemLabel?: (score: number, max: number) => string;
  size?: StrataSize;
  material?: string;
  level?: StrataLevel;
  class?: string;
  [attribute: string]: unknown;
}

const { label, name, max = 5, value, itemLabel = ratingItemLabel, size, material, level, class: className, ...rest } = Astro.props;
const scores = Array.from({ length: max }, (_, index) => index + 1);
---
<fieldset class={classes("ug-rating", className)} {...strataAttributes({ size, material, level })} {...rest}>
  <legend class="ug-rating__legend">{label}</legend>
  <div class="ug-rating__stars">
    {scores.map(score => (
      <label class="ug-rating__item">
        <input class="ug-rating__input" type="radio" name={name} value={String(score)} checked={score === value} />
        <span class="ug-rating__star" aria-hidden="true"></span>
        <span class="ug-rating__label">{itemLabel(score, max)}</span>
      </label>
    ))}
  </div>
</fieldset>
