---
/** Link (anatomy page `link.md`): a native `<a href>`. `standalone` gives it a 24 px target. */
import { classes } from "../shared/markup.ts";

interface Props {
  href: string;
  standalone?: boolean;
  class?: string;
  [attribute: string]: unknown;
}

const { href, standalone = false, class: className, ...rest } = Astro.props;
---
<a class={classes("ug-link", standalone && "ug-link--standalone", className)} href={href} {...rest}><slot /></a>
