{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RaananW/underglass/blob/main/packages/ui/src/tokens/strata-scene.schema.json",
  "title": "Strata scene, versions 1 to 3",
  "description": "One layer at one moment, for the Strata rendering model (docs/ui-library/rendering-model.md). Lengths are layer-local CSS px, x right and y down; angles are degrees; colours are sRGB #rrggbb. Every value is already resolved for a depth and theme.",
  "type": "object",
  "required": [
    "format",
    "version",
    "extent",
    "backdrop",
    "light",
    "bevel",
    "shadow",
    "interior",
    "state",
    "focus",
    "materials",
    "primitives"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "strata-scene"
    },
    "version": {
      "enum": [
        1,
        2,
        3
      ],
      "description": "1: Relief. 2: adds objects, the camera and the environment (the Objects level). 3: adds environment maps (the Scene level)."
    },
    "camera": {
      "description": "Version 2: the camera objects are seen through (design language section 2).",
      "type": "object",
      "required": [
        "distance",
        "vanish"
      ],
      "additionalProperties": false,
      "properties": {
        "distance": {
          "description": "Distance from the panel plane, in CSS px.",
          "type": "number",
          "minimum": 100
        },
        "vanish": {
          "description": "The vanishing point (the stage's centre), in layer-local CSS px.",
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "environment": {
      "description": "Versions 2 and 3: the environment objects reflect. Default: studio at strength 0.6. Version 3 may name a map.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "source",
            "strength"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "studio"
            },
            "strength": {
              "$ref": "#/$defs/unit"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "source",
            "strength",
            "grid"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "const": "map"
            },
            "strength": {
              "$ref": "#/$defs/unit"
            },
            "grid": {
              "description": "32 × 16 brightness values, row by row from the zenith.",
              "type": "array",
              "minItems": 512,
              "maxItems": 512,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 4
              }
            }
          }
        }
      ]
    },
    "extent": {
      "description": "The layer's size: its border box.",
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "width": {
          "$ref": "#/$defs/length"
        },
        "height": {
          "$ref": "#/$defs/length"
        }
      }
    },
    "outset": {
      "description": "Room drawn outside the extent, for shadows only. It never takes hits. Defaults to 0 on every side.",
      "type": "object",
      "required": [
        "top",
        "right",
        "bottom",
        "left"
      ],
      "additionalProperties": false,
      "properties": {
        "top": {
          "$ref": "#/$defs/length"
        },
        "right": {
          "$ref": "#/$defs/length"
        },
        "bottom": {
          "$ref": "#/$defs/length"
        },
        "left": {
          "$ref": "#/$defs/length"
        }
      }
    },
    "backdrop": {
      "description": "The colour under the layer; conformance renders over it.",
      "$ref": "#/$defs/colour"
    },
    "light": {
      "description": "The one key light (design language section 3).",
      "type": "object",
      "required": [
        "azimuth",
        "elevation"
      ],
      "additionalProperties": false,
      "properties": {
        "azimuth": {
          "description": "Where the light comes from, clockwise from the top of the screen.",
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "elevation": {
          "description": "Height of the light above the panel plane.",
          "type": "number",
          "minimum": 1,
          "maximum": 90
        }
      }
    },
    "bevel": {
      "type": "object",
      "required": [
        "width",
        "gain",
        "profile"
      ],
      "additionalProperties": false,
      "properties": {
        "width": {
          "$ref": "#/$defs/length"
        },
        "gain": {
          "type": "number",
          "minimum": 0
        },
        "profile": {
          "enum": [
            "quarter-round",
            "chamfer",
            "cove"
          ]
        }
      }
    },
    "shadow": {
      "type": "object",
      "required": [
        "strength"
      ],
      "additionalProperties": false,
      "properties": {
        "strength": {
          "$ref": "#/$defs/unit"
        }
      }
    },
    "interior": {
      "description": "The contrast budget on face interiors.",
      "type": "object",
      "required": [
        "max"
      ],
      "additionalProperties": false,
      "properties": {
        "max": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.1
        }
      }
    },
    "state": {
      "type": "object",
      "required": [
        "hoverHeight",
        "pressHeight",
        "hoverLift",
        "pressSink"
      ],
      "additionalProperties": false,
      "properties": {
        "hoverHeight": {
          "type": "number",
          "minimum": 0
        },
        "pressHeight": {
          "type": "number",
          "minimum": 0
        },
        "hoverLift": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.1
        },
        "pressSink": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.1
        }
      }
    },
    "focus": {
      "type": "object",
      "required": [
        "colour",
        "width",
        "offset"
      ],
      "additionalProperties": false,
      "properties": {
        "colour": {
          "$ref": "#/$defs/colour"
        },
        "width": {
          "$ref": "#/$defs/length"
        },
        "offset": {
          "$ref": "#/$defs/length"
        }
      }
    },
    "materials": {
      "description": "Materials by name, as numeric layers. Colours come from the captured content.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/material"
      }
    },
    "primitives": {
      "description": "Relief primitives, back to front: a later primitive sits on an earlier one. Version 2 may mix objects in.",
      "type": "array",
      "maxItems": 256,
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/primitive"
          },
          {
            "$ref": "#/$defs/object"
          }
        ]
      }
    }
  },
  "$defs": {
    "length": {
      "type": "number",
      "minimum": 0
    },
    "unit": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "colour": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "roughness": {
              "$ref": "#/$defs/unit"
            },
            "metallic": {
              "$ref": "#/$defs/unit"
            }
          },
          "description": "Defaults: roughness 1, metallic 0."
        },
        "coat": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strength": {
              "$ref": "#/$defs/unit"
            },
            "roughness": {
              "$ref": "#/$defs/unit"
            },
            "ior": {
              "type": "number",
              "minimum": 1,
              "maximum": 3
            }
          },
          "description": "Defaults: strength 0, roughness 0, ior 1.5."
        },
        "emissive": {
          "description": "An emissive material (strength above 0) is unlit; it still casts. Default strength 0.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 4
            }
          }
        },
        "sheen": {
          "description": "Reserved in version 1: accepted and ignored.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strength": {
              "$ref": "#/$defs/unit"
            },
            "roughness": {
              "$ref": "#/$defs/unit"
            }
          }
        },
        "iridescence": {
          "description": "Reserved in version 1: accepted and ignored.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strength": {
              "$ref": "#/$defs/unit"
            },
            "thickness": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "transmission": {
          "description": "Reserved in version 1: accepted and ignored.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strength": {
              "$ref": "#/$defs/unit"
            },
            "ior": {
              "type": "number",
              "minimum": 1,
              "maximum": 3
            },
            "frost": {
              "$ref": "#/$defs/unit"
            }
          }
        }
      }
    },
    "primitive": {
      "type": "object",
      "required": [
        "face",
        "rect",
        "height",
        "material"
      ],
      "additionalProperties": false,
      "properties": {
        "face": {
          "enum": [
            "raised",
            "well",
            "groove",
            "knob",
            "mark",
            "ring",
            "flat"
          ]
        },
        "rect": {
          "description": "[x, y, width, height] of the element's border box.",
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/length"
            },
            {
              "$ref": "#/$defs/length"
            }
          ]
        },
        "radius": {
          "description": "Corner radius, clamped to half the shorter side. A knob is always fully round.",
          "$ref": "#/$defs/length"
        },
        "height": {
          "description": "Height above the face for raised parts; depth below it for wells (reserved in version 1).",
          "$ref": "#/$defs/length"
        },
        "material": {
          "description": "A key of the scene's materials.",
          "type": "string"
        },
        "finish": {
          "description": "Whether the material's finish zones apply.",
          "type": "boolean"
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hover": {
              "type": "boolean"
            },
            "pressed": {
              "type": "boolean"
            },
            "focus": {
              "type": "boolean"
            },
            "disabled": {
              "type": "boolean"
            }
          }
        },
        "ring": {
          "description": "For the ring face only: the annulus thickness and its arc, in degrees clockwise from the top.",
          "type": "object",
          "required": [
            "thickness",
            "start",
            "sweep",
            "colour"
          ],
          "additionalProperties": false,
          "properties": {
            "thickness": {
              "$ref": "#/$defs/length"
            },
            "start": {
              "type": "number",
              "minimum": -360,
              "maximum": 360
            },
            "sweep": {
              "type": "number",
              "minimum": 0,
              "maximum": 360
            },
            "colour": {
              "$ref": "#/$defs/colour"
            }
          }
        }
      },
      "if": {
        "properties": {
          "face": {
            "const": "ring"
          }
        }
      },
      "then": {
        "required": [
          "ring"
        ]
      },
      "else": {
        "not": {
          "required": [
            "ring"
          ]
        }
      }
    },
    "object": {
      "description": "Version 2: an object standing on its base rectangle, the native control's border box (design language section 6).",
      "type": "object",
      "required": [
        "object",
        "rect",
        "height",
        "material"
      ],
      "additionalProperties": false,
      "properties": {
        "object": {
          "enum": [
            "key",
            "slab",
            "bezel",
            "well",
            "rail",
            "mark",
            "knob",
            "puck"
          ],
          "description": "Solids (key, slab, bezel, well, rail, mark) taper; domes (knob, puck) are ray-cast."
        },
        "rect": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/length"
            },
            {
              "$ref": "#/$defs/length"
            }
          ],
          "minItems": 4,
          "maxItems": 4,
          "description": "[x, y, width, height] of the base."
        },
        "radius": {
          "$ref": "#/$defs/length",
          "description": "A solid's corner radius; clamped to half the shorter side."
        },
        "height": {
          "$ref": "#/$defs/length",
          "description": "Height above base; a well's depth below it."
        },
        "base": {
          "type": "number",
          "description": "Height of the surface it stands on. Default 0."
        },
        "taper": {
          "$ref": "#/$defs/length",
          "description": "A solid's inset of its cap from its base."
        },
        "width": {
          "$ref": "#/$defs/length",
          "description": "A bezel's ring width; required for a bezel."
        },
        "travel": {
          "$ref": "#/$defs/length",
          "description": "How far a key's or mark's cap sinks when pressed."
        },
        "material": {
          "type": "string"
        },
        "colour": {
          "$ref": "#/$defs/colour",
          "description": "A dome's own colour; required for domes."
        },
        "finish": {
          "type": "boolean"
        },
        "bounds": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/length"
            },
            {
              "$ref": "#/$defs/length"
            }
          ],
          "minItems": 4,
          "maxItems": 4,
          "description": "The native control's border box, which must contain every drawn pixel. Default rect."
        },
        "state": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hover": {
              "type": "boolean"
            },
            "pressed": {
              "type": "boolean"
            },
            "focus": {
              "type": "boolean"
            },
            "disabled": {
              "type": "boolean"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "object": {
                "enum": [
                  "knob",
                  "puck"
                ]
              }
            }
          },
          "then": {
            "required": [
              "colour"
            ],
            "properties": {
              "taper": false,
              "width": false,
              "travel": false
            }
          },
          "else": {
            "properties": {
              "colour": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "object": {
                "const": "bezel"
              }
            }
          },
          "then": {
            "required": [
              "width"
            ]
          },
          "else": {
            "properties": {
              "width": false
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "enum": [
              2,
              3
            ]
          }
        }
      },
      "then": {
        "required": [
          "camera"
        ]
      },
      "else": {
        "properties": {
          "camera": false,
          "environment": false,
          "primitives": {
            "items": {
              "$ref": "#/$defs/primitive"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "version": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "environment": {
            "properties": {
              "source": {
                "const": "studio"
              }
            }
          }
        }
      }
    }
  ]
}
