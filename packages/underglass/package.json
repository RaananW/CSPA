{
  "name": "@canvas-spa/react",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/library/index.js",
  "types": "./dist/library/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/library/index.d.ts",
      "import": "./dist/library/index.js"
    },
    "./build": {
      "types": "./dist/library/build.d.ts",
      "import": "./dist/library/build.js"
    },
    "./experimental-worker": {
      "types": "./dist/library/experimental-worker.d.ts",
      "import": "./dist/library/experimental-worker.js"
    },
    "./experimental-worker/thread": {
      "types": "./dist/library/worker-thread.d.ts",
      "import": "./dist/library/worker-thread.js"
    }
  },
  "files": ["dist/library/*.js", "dist/library/*.d.ts", "docs/distribution.md"],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "prepack": "npm run build && node scripts/prepare-package.mjs"
  },
  "dependencies": {
    "@types/webxr": "0.5.24",
    "@babylonjs/lite": "1.33.0"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  }
}
